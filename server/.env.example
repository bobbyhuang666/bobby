# Bobby 后端配置
PORT=3000
MONGODB_URI=mongodb://localhost:27017/bobby
JWT_SECRET=请使用 openssl rand -hex 32 生成一个随机密钥

# LLM 配置（支持所有 OpenAI 兼容 API）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 支持的 Provider 示例：
# DeepSeek:  https://api.deepseek.com/v1/chat/completions  model=deepseek-chat
# OpenAI:    https://api.openai.com/v1/chat/completions    model=gpt-4o
# Ollama:    http://localhost:11434/v1/chat/completions     model=qwen2.5
# Groq:      https://api.groq.com/openai/v1/chat/completions model=llama-3.3-70b
# Together:  https://api.together.xyz/v1/chat/completions    model=meta-llama/Llama-3.3-70B

NODE_ENV=development

# Andy 引擎配置（可选）
# ANDY_USE_NATIVE=1  启用 Rust 原生加速（需要编译 native 模块）
ANDY_USE_NATIVE=0
